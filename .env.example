# =============================================================================
#  Celebrity Quiz — Environment variables
#  Copy to .env and adjust values:  cp .env.example .env
# =============================================================================

# ── Docker image ──────────────────────────────────────────────────────────────
IMAGE_NAME=celebrity-quiz
IMAGE_TAG=latest

# ── Ports ─────────────────────────────────────────────────────────────────────
PORT=3000       # production container host port
DEV_PORT=3001   # dev container host port

# ── Deployment ────────────────────────────────────────────────────────────────
DOMAIN=localhost                          # your real domain for Traefik TLS

# ── Docker registry (for make push) ──────────────────────────────────────────
# REGISTRY=ghcr.io/phoenix78

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Europe/Paris

# ── Dev options ───────────────────────────────────────────────────────────────
# Set to true on WSL2 or VirtualBox if hot-reload doesn't work
WATCHPACK_POLLING=false
