# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# For Docker: postgresql://postgres:postgres@postgres:5432/celebrity_quiz
# For local: postgresql://postgres:postgres@localhost:5432/celebrity_quiz
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/celebrity_quiz?schema=public"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# Public URL of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Docker (optional overrides) ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=celebrity_quiz
PORT=3000
TZ=Europe/Paris
